{
  "name": "@fullhuman/orphos",
  "version": "0.2.0",
  "description": "WebAssembly web interface for Orphos gene finder",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir www/pkg",
    "build:release": "wasm-pack build --target web --release --out-dir www/pkg",
    "build:node": "wasm-pack build --target nodejs --release --scope fullhuman --out-name orphos --out-dir pkg-node && npm run fix:node-package-name",
    "fix:node-package-name": "node -e \"const fs=require('fs');const p='pkg-node/package.json';const j=JSON.parse(fs.readFileSync(p,'utf8'));j.name='@fullhuman/orphos';fs.writeFileSync(p,JSON.stringify(j,null,2)+'\\n');\"",
    "serve": "python3 -m http.server 8080 --directory www",
    "start": "npm run build && npm run serve",
    "clean": "rm -rf www/pkg target"
  },
  "keywords": [
    "webassembly",
    "bioinformatics",
    "gene-prediction",
    "orphos"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {}
}
